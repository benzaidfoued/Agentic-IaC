{
  "id": "local-demo",
  "description": "No-cloud Terraform demo. Creates terraform_data state only; no external providers, cloud account or API key.",
  "engine": "terraform",
  "parameters": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "name": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{2,39}$"
      },
      "environment": {
        "type": "string",
        "enum": [
          "dev",
          "staging",
          "prod"
        ],
        "default": "dev"
      }
    },
    "required": [
      "name"
    ]
  },
  "template": {
    "terraform": {
      "required_version": ">= 1.9.0, < 2.0.0"
    },
    "resource": {
      "terraform_data": {
        "demo": {
          "input": {
            "name": "{{name}}",
            "environment": "{{environment}}"
          }
        }
      }
    },
    "output": {
      "demo": {
        "value": "${terraform_data.demo.output}"
      }
    }
  }
}
